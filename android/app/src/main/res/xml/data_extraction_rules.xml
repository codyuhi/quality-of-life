<?xml version="1.0" encoding="utf-8"?>
<!-- Back up theme and search preferences; caches are re-downloaded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="quality_of_life.db" />
    </device-transfer>
</data-extraction-rules>
