<?xml version="1.0" encoding="utf-8"?>
<!-- *.lan.codyuhi.online serves a publicly trusted Let's Encrypt certificate: system CAs only, HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
